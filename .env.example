# Export these variables via your process manager; Django does not auto-load .env.
APP_ENV=development
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Production values are required; do not commit actual credentials.
# DJANGO_SECRET_KEY=<random value at least 50 characters>
# POSTGRES_DB=scroll_questionnaire
# POSTGRES_USER=scroll_app
# POSTGRES_PASSWORD=<secret>
# POSTGRES_HOST=<EU database hostname>
# POSTGRES_SSLMODE=require
# REDIS_URL=rediss://<private-redis>
# CSRF_TRUSTED_ORIGINS=https://<your-domain>
# GOOGLE_SHEETS_ID=<approved spreadsheet ID>
# GOOGLE_APPLICATION_CREDENTIALS=<local service-account file, never commit>
# SCROLL_DATA_DIR=<absolute private directory for local SQLite and stimuli>
